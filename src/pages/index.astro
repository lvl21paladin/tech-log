---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => (b.data.date ?? new Date(0)).valueOf() - (a.data.date ?? new Date(0)).valueOf()
);

const formatter = new Intl.DateTimeFormat('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---
<BaseLayout title="tech log">
  <p class="intro">I document the projects I build and the technology I learn along the way.</p>

  {posts.map((post) => {
    const title = post.data.title ?? post.slug.replace(/-/g, ' ');
    const date = post.data.date ?? new Date();
    return (
      <a class="card" href={`${import.meta.env.BASE_URL}posts/${post.slug}/`}>
        <div class="card-top">
          <p class="card-title">{title}</p>
          <span class="card-date">{formatter.format(date)}</span>
        </div>
        <p class="card-excerpt">{post.data.excerpt}</p>
        <div class="tags">
          {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </a>
    );
  })}
</BaseLayout>